{
  "_schema": "企业官网投递适配器配置。每个公司一个 key，含登录/岗位列表/投递选择器。凭据走 credential_store。选择器在真实官网 DOM 核对后填入。",
  "example": {
    "name": "示例企业官网（占位，替换成你目标公司的官网）",
    "careers_url": "https://example.com/careers",
    "social_url": "https://example.com/careers/social",
    "login_button_selector": "button.loginBtn",
    "login_mode": "phone_sms",
    "phone_input_selector": "input[placeholder*='手机号码']",
    "sms_input_selector": "input[placeholder*='验证码']",
    "job_item_selector": ".position_list_item",
    "job_title_selector": ".postion_name .title",
    "job_city_selector": ".split_line_box_item.city",
    "job_id_attr": "data-jobunionid",
    "job_detail_url_pattern": "https://example.com/careers/position/detail?id={id}",
    "resume_input_selector": "input[type=file]",
    "apply_selector": "button.mtd-button-large",
    "receipt_marker": "投递成功|已提交|申请已收到",
    "note": "示例模板：岗位列表公开可读；详情页按 job_detail_url_pattern 拼 URL；登录后「立即申请」= 主按钮；登录=手机号+短信验证码（验证码人工收）。选择器取自一个真实企业官网招聘系统，新公司按各自 DOM 重核。"
  }
}
